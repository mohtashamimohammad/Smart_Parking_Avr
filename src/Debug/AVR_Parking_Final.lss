                                 .equ	RWW_START_ADDR	= 0x0
                                 .equ	RWW_STOP_ADDR	= 0x37ff
                                 .equ	PAGESIZE	= 64
                                 .equ	FIRSTBOOTSTART	= 0x3f00
                                 .equ	SECONDBOOTSTART	= 0x3e00
                                 .equ	THIRDBOOTSTART	= 0x3c00
                                 .equ	FOURTHBOOTSTART	= 0x3800
                                 .equ	SMALLBOOTSTART	= FIRSTBOOTSTART
                                 .equ	LARGEBOOTSTART	= FOURTHBOOTSTART
                                 
                                 
                                 
                                 ; ***** INTERRUPT VECTORS ************************************************
                                 .equ	INT0addr	= 0x0002	; External Interrupt Request 0
                                 .equ	INT1addr	= 0x0004	; External Interrupt Request 1
                                 .equ	PCI0addr	= 0x0006	; Pin Change Interrupt Request 0
                                 .equ	PCI1addr	= 0x0008	; Pin Change Interrupt Request 0
                                 .equ	PCI2addr	= 0x000a	; Pin Change Interrupt Request 1
                                 .equ	WDTaddr	= 0x000c	; Watchdog Time-out Interrupt
                                 .equ	OC2Aaddr	= 0x000e	; Timer/Counter2 Compare Match A
                                 .equ	OC2Baddr	= 0x0010	; Timer/Counter2 Compare Match A
                                 .equ	OVF2addr	= 0x0012	; Timer/Counter2 Overflow
                                 .equ	ICP1addr	= 0x0014	; Timer/Counter1 Capture Event
                                 .equ	OC1Aaddr	= 0x0016	; Timer/Counter1 Compare Match A
                                 .equ	OC1Baddr	= 0x0018	; Timer/Counter1 Compare Match B
                                 .equ	OVF1addr	= 0x001a	; Timer/Counter1 Overflow
                                 .equ	OC0Aaddr	= 0x001c	; TimerCounter0 Compare Match A
                                 .equ	OC0Baddr	= 0x001e	; TimerCounter0 Compare Match B
                                 .equ	OVF0addr	= 0x0020	; Timer/Couner0 Overflow
                                 .equ	SPIaddr	= 0x0022	; SPI Serial Transfer Complete
                                 .equ	URXCaddr	= 0x0024	; USART Rx Complete
                                 .equ	UDREaddr	= 0x0026	; USART, Data Register Empty
                                 .equ	UTXCaddr	= 0x0028	; USART Tx Complete
                                 .equ	ADCCaddr	= 0x002a	; ADC Conversion Complete
                                 .equ	ERDYaddr	= 0x002c	; EEPROM Ready
                                 .equ	ACIaddr	= 0x002e	; Analog Comparator
                                 .equ	TWIaddr	= 0x0030	; Two-wire Serial Interface
                                 .equ	SPMRaddr	= 0x0032	; Store Program Memory Read
                                 
                                 .equ	INT_VECTORS_SIZE	= 52	; size in words
                                 
                                 #endif  /* _M328PDEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 ; ============================================================
                                 ; SMART PARKING SYSTEM - STABLE PRESENTATION BUILD
                                 ; MCU      : ATmega328P
                                 ; Language : AVR Assembly (AVRASM2 / Atmel Studio 7)
                                 ; Clock    : 16 MHz
                                 ;
                                 ; Final functions:
                                 ; - 16x2 LCD in 4-bit mode
                                 ; - Initial capacity setting by 4x3 keypad (1..99)
                                 ; - Vehicle entry by pulse on PD2
                                 ; - Manual/demo entry by # after setup
                                 ; - Vehicle exit by push button on PD3
                                 ; - Manual/demo exit by * after setup
                                 ; - Free-space counter with upper/lower bounds
                                 ; - Servo gate control on PD6
                                 ; - Green LED, red LED and buzzer status
                                 ;
                                 ; IMPORTANT PIN MAP:
                                 ; LCD: PB0=RS, PB1=E, PB2=D4, PB3=D5, PB4=D6, PB5=D7
                                 ; Keypad rows A..D: PC0..PC3
                                 ; Keypad cols 1,2,3: PC4, PC5, PD7
                                 ; PD0=Buzzer, PD1=Red LED, PD2=Car Pulse, PD3=Exit Button
                                 ; PD5=Green LED, PD6=Servo CTRL
                                 ; ============================================================
                                 ;
                                 
                                 .include "m328pdef.inc"
                                 
                                 ;***** Created: 2011-02-09 12:03 ******* Source: ATmega328P.xml **********
                                 ;*************************************************************************
                                 ;* A P P L I C A T I O N   N O T E   F O R   T H E   A V R   F A M I L Y
                                 ;* 
                                 ;* Number            : AVR000
                                 ;* File Name         : "m328Pdef.inc"
                                 ;* Title             : Register/Bit Definitions for the ATmega328P
                                 ;* Date              : 2011-02-09
                                 ;* Version           : 2.35
                                 ;* Support E-mail    : avr@atmel.com
                                 ;* Target MCU        : ATmega328P
                                 ;* 
                                 ;* DESCRIPTION
                                 ;* When including this file in the assembly program file, all I/O register 
                                 ;* names and I/O register bit names appearing in the data book can be used.
                                 ;* In addition, the six registers forming the three data pointers X, Y and 
                                 ;* Z have been assigned names XL - ZH. Highest RAM address for Internal 
                                 ;* SRAM is also defined 
                                 ;* 
                                 ;* The Register names are represented by their hexadecimal address.
                                 ;* 
                                 ;* The Register Bit names are represented by their bit number (0-7).
                                 ;* 
                                 ;* Please observe the difference in using the bit names with instructions
                                 ;* such as "sbr"/"cbr" (set/clear bit in register) and "sbrs"/"sbrc"
                                 ;* (skip if bit in register set/cleared). The following example illustrates
                                 ;* this:
                                 ;* 
                                 ;* in    r16,PORTB             ;read PORTB latch
                                 ;* sbr   r16,(1<<PB6)+(1<<PB5) ;set PB6 and PB5 (use masks, not bit#)
                                 ;* out   PORTB,r16             ;output to PORTB
                                 ;* 
                                 ;* in    r16,TIFR              ;read the Timer Interrupt Flag Register
                                 ;* sbrc  r16,TOV0              ;test the overflow flag (use bit#)
                                 ;* rjmp  TOV0_is_set           ;jump if set
                                 ;* ...                         ;otherwise do something else
                                 ;*************************************************************************
                                 
                                 #ifndef _M328PDEF_INC_
                                 #endif  /* _M328PDEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 ; ============================================================
                                 ; PIN DEFINITIONS
                                 ; ============================================================
                                 
                                 .equ LCD_RS          = 0          ; PB0
                                 .equ LCD_E           = 1          ; PB1
                                 
                                 .equ BUZZER_PIN      = 0          ; PD0
                                 .equ RED_LED_PIN     = 1          ; PD1
                                 .equ CAR_PULSE_PIN   = 2          ; PD2
                                 .equ EXIT_BTN_PIN    = 3          ; PD3
                                 .equ GREEN_LED_PIN   = 5          ; PD5
                                 .equ SERVO_PIN       = 6          ; PD6
                                 
                                 ; ============================================================
                                 ; SRAM VARIABLES
                                 ; ============================================================
                                 
                                 .dseg
                                 .org SRAM_START
                                 
                                 total_capacity:
000100                               .byte 1
                                 
                                 free_slots:
000101                               .byte 1
                                 
                                 car_latch:
000102                               .byte 1
                                 
                                 exit_latch:
000103                               .byte 1
                                 
                                 ; ============================================================
                                 ; PROGRAM MEMORY / RESET VECTOR
                                 ; ============================================================
                                 
                                 .cseg
                                 .org 0x0000
000000 c000                          rjmp RESET
                                 
                                 ; ============================================================
                                 ; RESET / STARTUP
                                 ; ============================================================
                                 
                                 RESET:
000001 94f8                          cli
                                 
                                     ; Stack pointer
000002 e008                          ldi r16, HIGH(RAMEND)
000003 bf0e                          out SPH, r16
000004 ef0f                          ldi r16, LOW(RAMEND)
000005 bf0d                          out SPL, r16
                                 
000006 d01f                          rcall IO_INIT
                                 
000007 2700                          clr r16
000008 9300 0100                     sts total_capacity, r16
00000a 9300 0101                     sts free_slots, r16
00000c 9300 0102                     sts car_latch, r16
00000e 9300 0103                     sts exit_latch, r16
                                 
000010 d13b                          rcall LCD_INIT
                                 
                                     ; Safe initial outputs
000011 9858                          cbi PORTD, BUZZER_PIN
000012 9859                          cbi PORTD, RED_LED_PIN
000013 985d                          cbi PORTD, GREEN_LED_PIN
000014 985e                          cbi PORTD, SERVO_PIN
                                 
                                     ; Put the gate in the closed position
000015 d128                          rcall SERVO_CLOSE
                                 
                                     ; Ask for the initial capacity
000016 d01c                          rcall SET_CAPACITY_FROM_KEYPAD
                                 
                                     ; Ignore a pulse that is already HIGH when setup finishes.
000017 2700                          clr r16
000018 9b4a                          sbis PIND, CAR_PULSE_PIN
000019 c001                          rjmp RESET_SAVE_CAR_LATCH
00001a e001                          ldi r16, 1
                                 RESET_SAVE_CAR_LATCH:
00001b 9300 0102                     sts car_latch, r16
                                 
00001d 2700                          clr r16
00001e 9300 0103                     sts exit_latch, r16
                                 
000020 d105                          rcall UPDATE_STATUS_OUTPUTS
000021 d18b                          rcall SHOW_MAIN_SCREEN
                                 
                                 ; ============================================================
                                 ; MAIN LOOP
                                 ; ============================================================
                                 
                                 MAIN_LOOP:
000022 d0a9                          rcall CHECK_CAR_INPUT
000023 d0b7                          rcall CHECK_EXIT_BUTTON
000024 d0c9                          rcall CHECK_DEMO_KEYS
000025 cffc                          rjmp MAIN_LOOP
                                 
                                 ; ============================================================
                                 ; I/O INITIALIZATION
                                 ; ============================================================
                                 
                                 IO_INIT:
                                     ; PORTB: PB0..PB5 are LCD outputs
000026 e30f                          ldi r16, 0b00111111
000027 b904                          out DDRB, r16
000028 2700                          clr r16
000029 b905                          out PORTB, r16
                                 
                                     ; PORTC:
                                     ; PC0..PC3 keypad rows = outputs
                                     ; PC4..PC5 keypad columns = inputs with pull-ups
00002a e00f                          ldi r16, 0b00001111
00002b b907                          out DDRC, r16
00002c e30f                          ldi r16, 0b00111111
00002d b908                          out PORTC, r16
                                 
                                     ; PORTD:
                                     ; PD0 buzzer output
                                     ; PD1 red LED output
                                     ; PD2 car pulse input
                                     ; PD3 exit button input with pull-up
                                     ; PD4 unused input
                                     ; PD5 green LED output
                                     ; PD6 servo output
                                     ; PD7 keypad column input with pull-up
00002e e603                          ldi r16, 0b01100011
00002f b90a                          out DDRD, r16
000030 e808                          ldi r16, 0b10001000
000031 b90b                          out PORTD, r16
000032 9508                          ret
                                 
                                 ; ============================================================
                                 ; CAPACITY SETUP
                                 ; 0..9 = digits, # = confirm, * = clear
                                 ; Valid range: 1..99
                                 ; ============================================================
                                 
                                 SET_CAPACITY_FROM_KEYPAD:
000033 2744                          clr r20                    ; entered number
000034 2777                          clr r23                    ; digit count
                                 
000035 e001                          ldi r16, 0x01
000036 d134                          rcall LCD_CMD
000037 e003                          ldi r16, 3
000038 d1b9                          rcall DELAY_MS
                                 
000039 e1e6                          ldi ZL, LOW(2 * MSG_SET_CAPACITY)
00003a e0f4                          ldi ZH, HIGH(2 * MSG_SET_CAPACITY)
00003b d153                          rcall LCD_PRINT_STRING
                                 
00003c ec00                          ldi r16, 0xC0
00003d d12d                          rcall LCD_CMD
                                 
                                 CAPACITY_INPUT_LOOP:
00003e d036                          rcall KEYPAD_GET_KEY
00003f 2300                          tst r16
000040 f3e9                          breq CAPACITY_INPUT_LOOP
                                 
000041 3203                          cpi r16, '#'
000042 f159                          breq CAPACITY_CONFIRM
                                 
000043 320a                          cpi r16, '*'
000044 f0f9                          breq CAPACITY_CLEAR
                                 
000045 3300                          cpi r16, '0'
000046 f3b8                          brlo CAPACITY_INPUT_LOOP
000047 330a                          cpi r16, '9' + 1
000048 f7a8                          brsh CAPACITY_INPUT_LOOP
                                 
000049 5300                          subi r16, '0'
00004a 2f50                          mov r21, r16
                                 
00004b 2377                          tst r23
00004c f019                          breq CAPACITY_FIRST_DIGIT
                                 
00004d 3071                          cpi r23, 1
00004e f021                          breq CAPACITY_SECOND_DIGIT
                                 
                                     ; Maximum two digits
00004f cfee                          rjmp CAPACITY_INPUT_LOOP
                                 
                                 CAPACITY_FIRST_DIGIT:
000050 2f45                          mov r20, r21
000051 e071                          ldi r23, 1
000052 c007                          rjmp CAPACITY_SHOW_VALUE
                                 
                                 CAPACITY_SECOND_DIGIT:
                                     ; r20 = r20 * 10 + r21
000053 2f64                          mov r22, r20
000054 0f44                          lsl r20                    ; x2
000055 0f44                          lsl r20                    ; x4
000056 0f46                          add r20, r22               ; x5
000057 0f44                          lsl r20                    ; x10
000058 0f45                          add r20, r21
000059 e072                          ldi r23, 2
                                 
                                 CAPACITY_SHOW_VALUE:
00005a ec00                          ldi r16, 0xC0
00005b d10f                          rcall LCD_CMD
00005c e5ee                          ldi ZL, LOW(2 * MSG_LCD_SPACES)
00005d e0f4                          ldi ZH, HIGH(2 * MSG_LCD_SPACES)
00005e d130                          rcall LCD_PRINT_STRING
                                 
00005f ec00                          ldi r16, 0xC0
000060 d10a                          rcall LCD_CMD
000061 2f04                          mov r16, r20
000062 d132                          rcall LCD_PRINT_NUMBER
000063 cfda                          rjmp CAPACITY_INPUT_LOOP
                                 
                                 CAPACITY_CLEAR:
000064 2744                          clr r20
000065 2777                          clr r23
                                 
000066 ec00                          ldi r16, 0xC0
000067 d103                          rcall LCD_CMD
000068 e5ee                          ldi ZL, LOW(2 * MSG_LCD_SPACES)
000069 e0f4                          ldi ZH, HIGH(2 * MSG_LCD_SPACES)
00006a d124                          rcall LCD_PRINT_STRING
00006b ec00                          ldi r16, 0xC0
00006c d0fe                          rcall LCD_CMD
00006d cfd0                          rjmp CAPACITY_INPUT_LOOP
                                 
                                 CAPACITY_CONFIRM:
00006e 2344                          tst r20
00006f f271                          breq CAPACITY_INPUT_LOOP
                                 
000070 9340 0100                     sts total_capacity, r20
000072 9340 0101                     sts free_slots, r20
000074 9508                          ret
                                 
                                 ; ============================================================
                                 ; KEYPAD SCANNER
                                 ; Rows A,B,C,D -> PC0,PC1,PC2,PC3
                                 ; Columns 1,2,3 -> PC4,PC5,PD7
                                 ; Return: r16 = ASCII key, or 0 when no key is pressed
                                 ; ============================================================
                                 
                                 KEYPAD_GET_KEY:
                                     ; Row A low
000075 e31e                          ldi r17, 0b00111110
000076 b918                          out PORTC, r17
000077 d04e                          rcall KEYPAD_SMALL_DELAY
000078 9b34                          sbis PINC, 4
000079 c023                          rjmp KEY_A1
00007a 9b35                          sbis PINC, 5
00007b c023                          rjmp KEY_A2
00007c 9b4f                          sbis PIND, 7
00007d c023                          rjmp KEY_A3
                                 
                                     ; Row B low
00007e e31d                          ldi r17, 0b00111101
00007f b918                          out PORTC, r17
000080 d045                          rcall KEYPAD_SMALL_DELAY
000081 9b34                          sbis PINC, 4
000082 c020                          rjmp KEY_B1
000083 9b35                          sbis PINC, 5
000084 c020                          rjmp KEY_B2
000085 9b4f                          sbis PIND, 7
000086 c020                          rjmp KEY_B3
                                 
                                     ; Row C low
000087 e31b                          ldi r17, 0b00111011
000088 b918                          out PORTC, r17
000089 d03c                          rcall KEYPAD_SMALL_DELAY
00008a 9b34                          sbis PINC, 4
00008b c01d                          rjmp KEY_C1
00008c 9b35                          sbis PINC, 5
00008d c01d                          rjmp KEY_C2
00008e 9b4f                          sbis PIND, 7
00008f c01d                          rjmp KEY_C3
                                 
                                     ; Row D low
000090 e317                          ldi r17, 0b00110111
000091 b918                          out PORTC, r17
000092 d033                          rcall KEYPAD_SMALL_DELAY
000093 9b34                          sbis PINC, 4
000094 c01a                          rjmp KEY_D1
000095 9b35                          sbis PINC, 5
000096 c01a                          rjmp KEY_D2
000097 9b4f                          sbis PIND, 7
000098 c01a                          rjmp KEY_D3
                                 
000099 2700                          clr r16
00009a e31f                          ldi r17, 0b00111111
00009b b918                          out PORTC, r17
00009c 9508                          ret
                                 
                                 KEY_A1:
00009d e301                          ldi r16, '1'
00009e c015                          rjmp KEYPAD_KEY_FOUND
                                 KEY_A2:
00009f e302                          ldi r16, '2'
0000a0 c013                          rjmp KEYPAD_KEY_FOUND
                                 KEY_A3:
0000a1 e303                          ldi r16, '3'
0000a2 c011                          rjmp KEYPAD_KEY_FOUND
                                 KEY_B1:
0000a3 e304                          ldi r16, '4'
0000a4 c00f                          rjmp KEYPAD_KEY_FOUND
                                 KEY_B2:
0000a5 e305                          ldi r16, '5'
0000a6 c00d                          rjmp KEYPAD_KEY_FOUND
                                 KEY_B3:
0000a7 e306                          ldi r16, '6'
0000a8 c00b                          rjmp KEYPAD_KEY_FOUND
                                 KEY_C1:
0000a9 e307                          ldi r16, '7'
0000aa c009                          rjmp KEYPAD_KEY_FOUND
                                 KEY_C2:
0000ab e308                          ldi r16, '8'
0000ac c007                          rjmp KEYPAD_KEY_FOUND
                                 KEY_C3:
0000ad e309                          ldi r16, '9'
0000ae c005                          rjmp KEYPAD_KEY_FOUND
                                 KEY_D1:
0000af e20a                          ldi r16, '*'
0000b0 c003                          rjmp KEYPAD_KEY_FOUND
                                 KEY_D2:
0000b1 e300                          ldi r16, '0'
0000b2 c001                          rjmp KEYPAD_KEY_FOUND
                                 KEY_D3:
0000b3 e203                          ldi r16, '#'
                                 
                                 KEYPAD_KEY_FOUND:
                                     ; Debounce while preserving the key
0000b4 930f                          push r16
0000b5 e104                          ldi r16, 20
0000b6 d13b                          rcall DELAY_MS
0000b7 910f                          pop r16
0000b8 930f                          push r16
                                 
                                 KEYPAD_WAIT_RELEASE:
                                     ; All rows low, then wait for all columns to return high
0000b9 e310                          ldi r17, 0b00110000
0000ba b918                          out PORTC, r17
0000bb d00a                          rcall KEYPAD_SMALL_DELAY
0000bc 9b34                          sbis PINC, 4
0000bd cffb                          rjmp KEYPAD_WAIT_RELEASE
0000be 9b35                          sbis PINC, 5
0000bf cff9                          rjmp KEYPAD_WAIT_RELEASE
0000c0 9b4f                          sbis PIND, 7
0000c1 cff7                          rjmp KEYPAD_WAIT_RELEASE
                                 
0000c2 e31f                          ldi r17, 0b00111111
0000c3 b918                          out PORTC, r17
0000c4 910f                          pop r16
0000c5 9508                          ret
                                 
                                 KEYPAD_SMALL_DELAY:
0000c6 932f                          push r18
0000c7 e322                          ldi r18, 50
                                 KEYPAD_SMALL_DELAY_LOOP:
0000c8 952a                          dec r18
0000c9 f7f1                          brne KEYPAD_SMALL_DELAY_LOOP
0000ca 912f                          pop r18
0000cb 9508                          ret
                                 
                                 ; ============================================================
                                 ; VEHICLE ENTRY INPUT
                                 ; A HIGH pulse on PD2 counts as one incoming car.
                                 ; Pulse width measurement was intentionally removed for a
                                 ; stable Proteus presentation. The pulse generator is the
                                 ; simulated equivalent of the ultrasonic detector.
                                 ; ============================================================
                                 
                                 CHECK_CAR_INPUT:
                                     ; LOW -> arm the next event
0000cc 9b4a                          sbis PIND, CAR_PULSE_PIN
0000cd c009                          rjmp CAR_INPUT_LOW
                                 
                                     ; HIGH -> handle only once
0000ce 9100 0102                     lds r16, car_latch
0000d0 2300                          tst r16
0000d1 f441                          brne CAR_INPUT_DONE
                                 
0000d2 e001                          ldi r16, 1
0000d3 9300 0102                     sts car_latch, r16
0000d5 d024                          rcall HANDLE_CAR_ENTRY
0000d6 9508                          ret
                                 
                                 CAR_INPUT_LOW:
0000d7 2700                          clr r16
0000d8 9300 0102                     sts car_latch, r16
                                 
                                 CAR_INPUT_DONE:
0000da 9508                          ret
                                 
                                 ; ============================================================
                                 ; EXIT BUTTON ON PD3 (active LOW, internal pull-up)
                                 ; ============================================================
                                 
                                 CHECK_EXIT_BUTTON:
                                     ; Released HIGH -> arm next press
0000db 9b4b                          sbis PIND, EXIT_BTN_PIN
0000dc c004                          rjmp EXIT_BUTTON_PRESSED
                                 
0000dd 2700                          clr r16
0000de 9300 0103                     sts exit_latch, r16
0000e0 9508                          ret
                                 
                                 EXIT_BUTTON_PRESSED:
0000e1 9100 0103                     lds r16, exit_latch
0000e3 2300                          tst r16
0000e4 f441                          brne EXIT_BUTTON_DONE
                                 
0000e5 e104                          ldi r16, 20
0000e6 d10b                          rcall DELAY_MS
                                 
                                     ; If it is no longer LOW, it was only bounce
0000e7 994b                          sbic PIND, EXIT_BTN_PIN
0000e8 c004                          rjmp EXIT_BUTTON_DONE
                                 
0000e9 e001                          ldi r16, 1
0000ea 9300 0103                     sts exit_latch, r16
0000ec d02b                          rcall HANDLE_CAR_EXIT
                                 
                                 EXIT_BUTTON_DONE:
0000ed 9508                          ret
                                 
                                 ; ============================================================
                                 ; DEMONSTRATION FALLBACK CONTROLS
                                 ; After capacity setup:
                                 ; # = simulate an incoming car
                                 ; * = simulate an outgoing car
                                 ; This makes the project presentable even if an external
                                 ; generator/button wire is not clicked during the demo.
                                 ; ============================================================
                                 
                                 CHECK_DEMO_KEYS:
0000ee df86                          rcall KEYPAD_GET_KEY
0000ef 2300                          tst r16
0000f0 f041                          breq DEMO_KEYS_DONE
                                 
0000f1 3203                          cpi r16, '#'
0000f2 f019                          breq DEMO_MANUAL_ENTRY
                                 
0000f3 320a                          cpi r16, '*'
0000f4 f019                          breq DEMO_MANUAL_EXIT
                                 
0000f5 c003                          rjmp DEMO_KEYS_DONE
                                 
                                 DEMO_MANUAL_ENTRY:
0000f6 d003                          rcall HANDLE_CAR_ENTRY
0000f7 c001                          rjmp DEMO_KEYS_DONE
                                 
                                 DEMO_MANUAL_EXIT:
0000f8 d01f                          rcall HANDLE_CAR_EXIT
                                 
                                 DEMO_KEYS_DONE:
0000f9 9508                          ret
                                 
                                 ; ============================================================
                                 ; ENTRY HANDLER
                                 ; ============================================================
                                 
                                 HANDLE_CAR_ENTRY:
0000fa 9100 0101                     lds r16, free_slots
0000fc 2300                          tst r16
0000fd f081                          breq HANDLE_PARKING_FULL
                                 
0000fe 9859                          cbi PORTD, RED_LED_PIN
0000ff 9858                          cbi PORTD, BUZZER_PIN
000100 9a5d                          sbi PORTD, GREEN_LED_PIN
                                 
000101 d0bb                          rcall SHOW_ENTRY_SCREEN
000102 d02d                          rcall SERVO_OPEN
000103 d0f5                          rcall DELAY_500MS
                                 
000104 9100 0101                     lds r16, free_slots
000106 950a                          dec r16
000107 9300 0101                     sts free_slots, r16
                                 
000109 d034                          rcall SERVO_CLOSE
00010a 985d                          cbi PORTD, GREEN_LED_PIN
00010b d01a                          rcall UPDATE_STATUS_OUTPUTS
00010c d0a0                          rcall SHOW_MAIN_SCREEN
00010d 9508                          ret
                                 
                                 HANDLE_PARKING_FULL:
00010e 985d                          cbi PORTD, GREEN_LED_PIN
00010f 9a59                          sbi PORTD, RED_LED_PIN
000110 9a58                          sbi PORTD, BUZZER_PIN
                                 
000111 d0b8                          rcall SHOW_FULL_SCREEN
000112 d0e6                          rcall DELAY_500MS
000113 9858                          cbi PORTD, BUZZER_PIN
000114 d0e4                          rcall DELAY_500MS
                                 
000115 d010                          rcall UPDATE_STATUS_OUTPUTS
000116 d096                          rcall SHOW_MAIN_SCREEN
000117 9508                          ret
                                 
                                 ; ============================================================
                                 ; EXIT HANDLER
                                 ; ============================================================
                                 
                                 HANDLE_CAR_EXIT:
000118 9100 0101                     lds r16, free_slots
00011a 9110 0100                     lds r17, total_capacity
                                 
                                     ; Do not exceed the initial capacity
00011c 1701                          cp r16, r17
00011d f438                          brsh CAR_EXIT_DONE
                                 
00011e 9503                          inc r16
00011f 9300 0101                     sts free_slots, r16
                                 
000121 d004                          rcall UPDATE_STATUS_OUTPUTS
000122 d0b4                          rcall SHOW_EXIT_SCREEN
000123 d0d5                          rcall DELAY_500MS
000124 d088                          rcall SHOW_MAIN_SCREEN
                                 
                                 CAR_EXIT_DONE:
000125 9508                          ret
                                 
                                 ; ============================================================
                                 ; NORMAL STATUS OUTPUTS
                                 ; Red LED is ON only when FREE=0.
                                 ; Green LED is ON only during an allowed entry.
                                 ; Buzzer is normally OFF.
                                 ; ============================================================
                                 
                                 UPDATE_STATUS_OUTPUTS:
000126 985d                          cbi PORTD, GREEN_LED_PIN
000127 9858                          cbi PORTD, BUZZER_PIN
                                 
000128 9100 0101                     lds r16, free_slots
00012a 2300                          tst r16
00012b f011                          breq STATUS_FULL
                                 
00012c 9859                          cbi PORTD, RED_LED_PIN
00012d 9508                          ret
                                 
                                 STATUS_FULL:
00012e 9a59                          sbi PORTD, RED_LED_PIN
00012f 9508                          ret
                                 
                                 ; ============================================================
                                 ; SERVO CONTROL
                                 ; Proteus MOTOR-PWMSERVO:
                                 ; CTRL -> PD6, VCC -> +5V, GND -> GND
                                 ; 1 ms = closed, 2 ms = open
                                 ; ============================================================
                                 
                                 SERVO_OPEN:
000130 930f                          push r16
000131 938f                          push r24
000132 e184                          ldi r24, 20
                                 SERVO_OPEN_LOOP:
000133 9a5e                          sbi PORTD, SERVO_PIN
000134 e002                          ldi r16, 2
000135 d0bc                          rcall DELAY_MS
000136 985e                          cbi PORTD, SERVO_PIN
000137 e102                          ldi r16, 18
000138 d0b9                          rcall DELAY_MS
000139 958a                          dec r24
00013a f7c1                          brne SERVO_OPEN_LOOP
00013b 918f                          pop r24
00013c 910f                          pop r16
00013d 9508                          ret
                                 
                                 SERVO_CLOSE:
00013e 930f                          push r16
00013f 938f                          push r24
000140 e184                          ldi r24, 20
                                 SERVO_CLOSE_LOOP:
000141 9a5e                          sbi PORTD, SERVO_PIN
000142 e001                          ldi r16, 1
000143 d0ae                          rcall DELAY_MS
000144 985e                          cbi PORTD, SERVO_PIN
000145 e103                          ldi r16, 19
000146 d0ab                          rcall DELAY_MS
000147 958a                          dec r24
000148 f7c1                          brne SERVO_CLOSE_LOOP
000149 918f                          pop r24
00014a 910f                          pop r16
00014b 9508                          ret
                                 
