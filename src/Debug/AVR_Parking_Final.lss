                                 ; ============================================================
                                 
                                 LCD_INIT:
00014c e104                          ldi r16, 20
00014d d0a4                          rcall DELAY_MS
                                 
00014e 9828                          cbi PORTB, LCD_RS
00014f 9829                          cbi PORTB, LCD_E
                                 
000150 e013                          ldi r17, 0x03
000151 d02c                          rcall LCD_SEND_NIBBLE
000152 e005                          ldi r16, 5
000153 d09e                          rcall DELAY_MS
                                 
000154 e013                          ldi r17, 0x03
000155 d028                          rcall LCD_SEND_NIBBLE
000156 e002                          ldi r16, 2
000157 d09a                          rcall DELAY_MS
                                 
000158 e013                          ldi r17, 0x03
000159 d024                          rcall LCD_SEND_NIBBLE
00015a e002                          ldi r16, 2
00015b d096                          rcall DELAY_MS
                                 
00015c e012                          ldi r17, 0x02
00015d d020                          rcall LCD_SEND_NIBBLE
00015e e002                          ldi r16, 2
00015f d092                          rcall DELAY_MS
                                 
000160 e208                          ldi r16, 0x28
000161 d009                          rcall LCD_CMD
000162 e00c                          ldi r16, 0x0C
000163 d007                          rcall LCD_CMD
000164 e006                          ldi r16, 0x06
000165 d005                          rcall LCD_CMD
000166 e001                          ldi r16, 0x01
000167 d003                          rcall LCD_CMD
000168 e003                          ldi r16, 3
000169 d088                          rcall DELAY_MS
00016a 9508                          ret
                                 
                                 LCD_CMD:
00016b 9828                          cbi PORTB, LCD_RS
00016c d004                          rcall LCD_SEND_BYTE
00016d 9508                          ret
                                 
                                 LCD_DATA:
00016e 9a28                          sbi PORTB, LCD_RS
00016f d001                          rcall LCD_SEND_BYTE
000170 9508                          ret
                                 
                                 LCD_SEND_BYTE:
000171 930f                          push r16
000172 931f                          push r17
                                 
000173 2f10                          mov r17, r16
000174 9512                          swap r17
000175 701f                          andi r17, 0x0F
000176 d007                          rcall LCD_SEND_NIBBLE
                                 
000177 2f10                          mov r17, r16
000178 701f                          andi r17, 0x0F
000179 d004                          rcall LCD_SEND_NIBBLE
                                 
00017a 911f                          pop r17
00017b 910f                          pop r16
00017c d06a                          rcall DELAY_1MS
00017d 9508                          ret
                                 
                                 LCD_SEND_NIBBLE:
00017e 931f                          push r17
00017f 932f                          push r18
                                 
                                     ; Preserve only RS, replace E and data bits
000180 b125                          in r18, PORTB
000181 7021                          andi r18, 0b00000001
                                 
000182 0f11                          lsl r17
000183 0f11                          lsl r17
000184 731c                          andi r17, 0b00111100
000185 2b21                          or r18, r17
000186 b925                          out PORTB, r18
                                 
000187 9a29                          sbi PORTB, LCD_E
000188 0000                          nop
000189 0000                          nop
00018a 0000                          nop
00018b 9829                          cbi PORTB, LCD_E
                                 
00018c 912f                          pop r18
00018d 911f                          pop r17
00018e 9508                          ret
                                 
                                 LCD_PRINT_STRING:
                                 LCD_PRINT_LOOP:
00018f 9105                          lpm r16, Z+
000190 2300                          tst r16
000191 f011                          breq LCD_PRINT_DONE
000192 dfdb                          rcall LCD_DATA
000193 cffb                          rjmp LCD_PRINT_LOOP
                                 LCD_PRINT_DONE:
000194 9508                          ret
                                 
                                 LCD_PRINT_NUMBER:
000195 931f                          push r17
000196 932f                          push r18
000197 933f                          push r19
                                 
000198 2f20                          mov r18, r16
000199 2711                          clr r17
                                 
                                 LCD_TENS_LOOP:
00019a 302a                          cpi r18, 10
00019b f018                          brlo LCD_TENS_DONE
00019c 502a                          subi r18, 10
00019d 9513                          inc r17
00019e cffb                          rjmp LCD_TENS_LOOP
                                 
                                 LCD_TENS_DONE:
00019f 2311                          tst r17
0001a0 f021                          breq LCD_PRINT_ONES
0001a1 2f01                          mov r16, r17
0001a2 e330                          ldi r19, '0'
0001a3 0f03                          add r16, r19
0001a4 dfc9                          rcall LCD_DATA
                                 
                                 LCD_PRINT_ONES:
0001a5 2f02                          mov r16, r18
0001a6 e330                          ldi r19, '0'
0001a7 0f03                          add r16, r19
0001a8 dfc5                          rcall LCD_DATA
                                 
0001a9 913f                          pop r19
0001aa 912f                          pop r18
0001ab 911f                          pop r17
0001ac 9508                          ret
                                 
                                 ; ============================================================
                                 ; LCD SCREENS
                                 ; ============================================================
                                 
                                 SHOW_MAIN_SCREEN:
0001ad e001                          ldi r16, 0x01
0001ae dfbc                          rcall LCD_CMD
0001af e003                          ldi r16, 3
0001b0 d041                          rcall DELAY_MS
                                 
0001b1 e0e0                          ldi ZL, LOW(2 * MSG_SMART_PARKING)
0001b2 e0f4                          ldi ZH, HIGH(2 * MSG_SMART_PARKING)
0001b3 dfdb                          rcall LCD_PRINT_STRING
                                 
0001b4 ec00                          ldi r16, 0xC0
0001b5 dfb5                          rcall LCD_CMD
0001b6 e0ee                          ldi ZL, LOW(2 * MSG_FREE)
0001b7 e0f4                          ldi ZH, HIGH(2 * MSG_FREE)
0001b8 dfd6                          rcall LCD_PRINT_STRING
0001b9 9100 0101                     lds r16, free_slots
0001bb dfd9                          rcall LCD_PRINT_NUMBER
0001bc 9508                          ret
                                 
                                 SHOW_ENTRY_SCREEN:
0001bd e001                          ldi r16, 0x01
0001be dfac                          rcall LCD_CMD
0001bf e003                          ldi r16, 3
0001c0 d031                          rcall DELAY_MS
                                 
0001c1 e2e4                          ldi ZL, LOW(2 * MSG_ENTRY_ALLOWED)
0001c2 e0f4                          ldi ZH, HIGH(2 * MSG_ENTRY_ALLOWED)
0001c3 dfcb                          rcall LCD_PRINT_STRING
                                 
0001c4 ec00                          ldi r16, 0xC0
0001c5 dfa5                          rcall LCD_CMD
0001c6 e3e2                          ldi ZL, LOW(2 * MSG_GATE_OPEN)
0001c7 e0f4                          ldi ZH, HIGH(2 * MSG_GATE_OPEN)
0001c8 dfc6                          rcall LCD_PRINT_STRING
0001c9 9508                          ret
                                 
                                 SHOW_FULL_SCREEN:
0001ca e001                          ldi r16, 0x01
0001cb df9f                          rcall LCD_CMD
0001cc e003                          ldi r16, 3
0001cd d024                          rcall DELAY_MS
                                 
0001ce e3ec                          ldi ZL, LOW(2 * MSG_PARKING_FULL)
0001cf e0f4                          ldi ZH, HIGH(2 * MSG_PARKING_FULL)
0001d0 dfbe                          rcall LCD_PRINT_STRING
                                 
0001d1 ec00                          ldi r16, 0xC0
0001d2 df98                          rcall LCD_CMD
0001d3 e4ea                          ldi ZL, LOW(2 * MSG_NO_ENTRY)
0001d4 e0f4                          ldi ZH, HIGH(2 * MSG_NO_ENTRY)
0001d5 dfb9                          rcall LCD_PRINT_STRING
0001d6 9508                          ret
                                 
                                 SHOW_EXIT_SCREEN:
0001d7 e001                          ldi r16, 0x01
0001d8 df92                          rcall LCD_CMD
0001d9 e003                          ldi r16, 3
0001da d017                          rcall DELAY_MS
                                 
0001db e5e4                          ldi ZL, LOW(2 * MSG_CAR_EXIT)
0001dc e0f4                          ldi ZH, HIGH(2 * MSG_CAR_EXIT)
0001dd dfb1                          rcall LCD_PRINT_STRING
                                 
0001de ec00                          ldi r16, 0xC0
0001df df8b                          rcall LCD_CMD
0001e0 e0ee                          ldi ZL, LOW(2 * MSG_FREE)
0001e1 e0f4                          ldi ZH, HIGH(2 * MSG_FREE)
0001e2 dfac                          rcall LCD_PRINT_STRING
0001e3 9100 0101                     lds r16, free_slots
0001e5 dfaf                          rcall LCD_PRINT_NUMBER
0001e6 9508                          ret
                                 
